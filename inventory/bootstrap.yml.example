---
# Copy to .secrets/bootstrap.yml for the first playbook run after factory reset,
# firmware upgrade, or any time Dropbear authorized_keys is not yet deployed.
#
#   cp inventory/bootstrap.yml.example .secrets/bootstrap.yml
#   # Edit ansible_ssh_pass if needed, then:
#   make ping-bootstrap
#   make site-bootstrap
#
# Remove .secrets/bootstrap.yml (or delete ansible_ssh_pass) after key-based
# login works with: make ping

ansible_ssh_pass: replace-with-temp-root-password
ansible_ssh_common_args: >-
  -o StrictHostKeyChecking=accept-new
  -o PreferredAuthentications=password,publickey
  -o KexAlgorithms=mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
  -o HostKeyAlgorithms=ssh-ed25519
  -o Ciphers=chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr
  -o MACs=hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-256
